// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Post {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  markdown_content String
  category         String
  image_url        String?
  source_link      String?
  generated_by_ai  Boolean  @default(false)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  name           String?
  plan           String        @default("FREE") // "FREE" | "TRIAL" | "PRO"
  planExpiresAt  DateTime?
  aiCredits      Int           @default(3) // 3 free starter AI credits
  dailyAiCreditsUsed Int           @default(0)
  lastCreditResetAt  DateTime      @default(now())
  customerId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sessions       UserSession[]
  cvs            Cv[]
  coverLetters   CoverLetter[]
  promoRedemptions UserPromoRedemption[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ==========================================
// P1: CV & RESUME BUILDER MODELS
// ==========================================

model Cv {
  id              String           @id @default(cuid())
  userId          String
  title           String           @default("Lebenslauf")
  language        String           @default("de")
  isDraft         Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalInfo    CvPersonalInfo?
  experiences     CvExperience[]
  educations      CvEducation[]
  skills          CvSkill[]
  languages       CvLanguage[]
  certifications  CvCertification[]
  projects        CvProject[]
  coverLetters    CoverLetter[]

  @@index([userId])
}

model CvPersonalInfo {
  id              String    @id @default(cuid())
  cvId            String    @unique
  fullName        String
  email           String
  phone           String?
  address         String?
  photoUrl        String?
  birthDate       DateTime?
  birthPlace      String?
  nationality     String?
  targetJobTitle  String?
  linkedinUrl     String?
  xingUrl         String?
  summary         String?

  cv              Cv        @relation(fields: [cvId], references: [id], onDelete: Cascade)
}

model CvExperience {
  id              String    @id @default(cuid())
  cvId            String
  company         String
  position        String
  city            String?
  country         String?   @default("Germany")
  startDate       DateTime
  endDate         DateTime?
  isCurrent       Boolean   @default(false)
  description     String?
  order           Int       @default(0)

  cv              Cv        @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId, order])
}

model CvEducation {
  id              String    @id @default(cuid())
  cvId            String
  institution     String
  degree          String
  fieldOfStudy    String?
  city            String?
  country         String?
  startDate       DateTime
  endDate         DateTime?
  isCurrent       Boolean   @default(false)
  grade           String?
  description     String?
  order           Int       @default(0)

  cv              Cv        @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId, order])
}

model CvSkill {
  id              String   @id @default(cuid())
  cvId            String
  name            String
  category        String?
  level           String?
  order           Int      @default(0)

  cv              Cv       @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId, order])
}

model CvLanguage {
  id              String   @id @default(cuid())
  cvId            String
  language        String
  proficiency     String
  order           Int      @default(0)

  cv              Cv       @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId, order])
}

model CvCertification {
  id              String    @id @default(cuid())
  cvId            String
  name            String
  issuer          String
  issueDate       DateTime?
  expiryDate      DateTime?
  credentialUrl   String?
  order           Int       @default(0)

  cv              Cv        @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId, order])
}

model CvProject {
  id              String   @id @default(cuid())
  cvId            String
  title           String
  role            String?
  url             String?
  description     String?
  order           Int      @default(0)

  cv              Cv       @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId, order])
}

model CoverLetter {
  id                String   @id @default(cuid())
  userId            String
  cvId              String?
  title             String   @default("Anschreiben")
  jobTitle          String
  companyName       String
  recipientName     String?
  jobDescriptionRaw String?
  language          String   @default("de")
  tone              String   @default("professional")
  generatedContent  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cv                Cv?      @relation(fields: [cvId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cvId])
}

// ==========================================
// P2: GERMAN JOB BOARD MODELS
// ==========================================

model Job {
  id             String   @id @default(cuid())
  title          String
  company        String
  city           String?  @default("Germany")
  category       String   @default("General")
  jobType        String?  @default("Full-time")
  languageReq    String?  @default("B1/B2")
  salary         String?
  applyUrl       String   @unique
  descriptionRaw String?
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([city])
  @@index([publishedAt])
}

// ==========================================
// P2: MONETIZATION & PROMO CODES
// ==========================================

model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  planGranted    String    @default("TRIAL") // "TRIAL" | "PRO"
  durationDays   Int       @default(7)
  creditsGranted Int       @default(15)
  maxUses        Int       @default(10)
  timesUsed      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  redemptions    UserPromoRedemption[]
}

model UserPromoRedemption {
  id          String    @id @default(cuid())
  userId      String
  promoCodeId String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([userId, promoCodeId])
  @@index([userId])
}

model ProcessedWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventName String
  userId    String?
  createdAt DateTime @default(now())
}



