    const data = parseResult.data;

    // If updating cvId, ensure referenced CV belongs to the authenticated user
    if (data.cvId) {
      const referencedCv = await prisma.cv.findFirst({
        where: {
          id: data.cvId,
          userId: authResult.user.id,
