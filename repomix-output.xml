      if (!referencedCv) {
        return NextResponse.json(
          {
            success: false,
            error: "Referenced CV not found or does not belong to you",
          },
          { status: 400 }
        );
      }
    }

    const updatedCoverLetter = await prisma.coverLetter.update({
