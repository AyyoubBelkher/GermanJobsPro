        },
        { status: 500 }
      );
    }
  } catch (error: unknown) {
    console.error("[POST /api/cv/magic-import Error]:", error instanceof Error ? error.message : error);
    return NextResponse.json(
      { success: false, error: "Internal Server Error" },
      { status: 500 }
