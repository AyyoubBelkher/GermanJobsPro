    .replace(/[\s\uFEFF\u200E\u200F]+$/, "")
    .trim();
  cleanGerman = cleanGerman.replace(/؟/g, "?").replace(/،/g, ",").replace(/؛/g, ";");

  const cleanPhonetic = phonetic ? stripBrackets(phonetic) : "";
