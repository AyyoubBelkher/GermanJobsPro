import { redirect } from "next/navigation";
import Navbar from "@/components/ui/Navbar";
import Footer from "@/components/ui/Footer";
import { verifyUserSession } from "@/lib/user-session";
import { prisma } from "@/lib/prisma";
import DossierCompilerClient from "@/components/dossier/DossierCompilerClient";

export default async function DossierPage({
  params,
}: {
  params: Promise<{ locale: string }>;
}) {
  const { locale } = await params;
  const isAr = locale === "ar";
  const isDe = locale === "de";
  const dir = isAr ? "rtl" : "ltr";

  const cookieStore = await cookies();
  const token = cookieStore.get("user_session")?.value;
  const authResult = await verifyUserSession(token);

  if (!authResult) {
    redirect(`/${locale}/auth/login`);
  }

  const userCvs = await prisma.cv.findMany({
    where: { userId: authResult.user.id },
    select: {
      id: true,
      title: true,
      language: true,
    },
    orderBy: { updatedAt: "desc" },
  });

  const userCoverLetters = await prisma.coverLetter.findMany({
    where: { userId: authResult.user.id },
    select: {
      id: true,
      title: true,
      jobTitle: true,
      companyName: true,
    },
    orderBy: { updatedAt: "desc" },
  });

  return (
    <div dir={dir} className="min-h-screen bg-slate-950 text-slate-100 font-sans flex flex-col justify-between">
      <Navbar locale={locale} />

      <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full flex-1 space-y-8">
        {/* Header Breadcrumbs */}
        <div className="flex items-center gap-2 text-xs text-slate-400 font-medium">
          <Link href={`/${locale}/dashboard`} className="hover:text-blue-400 transition-colors">
            {isAr ? "لوحة التحكم" : isDe ? "Dashboard" : "Dashboard"}
          </Link>
          <span>/</span>
          <span className="text-slate-200">
            {isAr ? "تجميع ملف الترشيح (Bewerbungsmappe)" : isDe ? "Bewerbungsmappe Studio" : "Dossier Studio"}
          </span>
        </div>

        <DossierCompilerClient
          userCvs={userCvs}
          userCoverLetters={userCoverLetters}
          locale={locale}
        />
      </main>

      <Footer locale={locale} />
    </div>
  );
}
</file>

