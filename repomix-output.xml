              {/* Resend Code Section */}
              <div className="pt-2 text-center text-xs space-y-2">
                <p className="text-slate-400">
                  {isAr ? "لم يصلك الرمز؟ " : isDe ? "Code nicht erhalten? " : "Didn't receive the code? "}
