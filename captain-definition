{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:20-alpine AS base",
    "WORKDIR /app",
    "COPY package*.json ./",
    "COPY prisma ./prisma/",
    "RUN npm install",
    "COPY . .",
    "RUN npx prisma generate",
    "RUN npm run build",
    "ENV NODE_ENV=production",
    "EXPOSE 3000",
    "CMD [\"npm\", \"start\"]"
  ]
}
