{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:22-slim AS base",
    "WORKDIR /app",
    "RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*",
    "COPY package*.json ./",
    "COPY prisma ./prisma/",
    "RUN npm install --no-audit",
    "COPY . .",
    "ENV NEXT_TELEMETRY_DISABLED=1",
    "RUN DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/dummy?sslmode=disable\" npx prisma generate",
    "RUN DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/dummy?sslmode=disable\" npm run build",
    "ENV NODE_ENV=production",
    "ENV HOSTNAME=0.0.0.0",
    "ENV PORT=3000",
    "EXPOSE 3000",
    "ENV WS_NO_BUFFER_UTIL=1",
    "ENV WS_NO_UTF_8_VALIDATE=1",
    "CMD [\"sh\", \"-c\", \"npx prisma db push && npm start\"]"
  ]
}
