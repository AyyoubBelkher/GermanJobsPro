{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:20-slim AS base",
    "WORKDIR /app",
    "RUN apt-get update && apt-get install -y python3 make g++ build-essential libsqlite3-dev openssl ca-certificates && rm -rf /var/lib/apt/lists/*",
    "COPY package*.json ./",
    "COPY prisma ./prisma/",
    "RUN npm install --no-audit",
    "COPY . .",
    "RUN npx prisma generate",
    "ENV NODE_OPTIONS=\"--max-old-space-size=2048\"",
    "ENV NEXT_TELEMETRY_DISABLED=1",
    "RUN npm run build",
    "ENV NODE_ENV=production",
    "EXPOSE 3000",
    "CMD [\"npm\", \"start\"]"
  ]
}
